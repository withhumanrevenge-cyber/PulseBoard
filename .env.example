# Clerk Authentication — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Clerk Dashboard -> Webhooks -> endpoint /api/webhooks/clerk (user.created/updated/deleted)
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase — Project Settings > API. Apply supabase/migrations/*.sql in order.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey... # server-only, never expose

# GitHub — used only to READ public data (profiles, contributions, search).
# Fine-grained token: Repository access = "Public repositories (read-only)",
# no account or repository permissions. Classic token: no scopes ticked.
GITHUB_TOKEN=github_pat_...

# PulseAI (Groq) — free key from https://console.groq.com/keys.
# If unset, the assistant renders a "needs configuration" state instead of crashing.
GROQ_API_KEY=gsk_...
# Optional override; defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Rate limiting (recommended in production) — https://console.upstash.com
# Without these, limits are per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL — used for canonical links, sitemap, and social cards.
NEXT_PUBLIC_APP_URL=http://localhost:3000
